DATABASE_URL="file:./prisma/dev.db"

# Optional — Google Calendar import. Create OAuth credentials in Google
# Cloud Console (Web app) and register this redirect URI:
#   http://localhost:3000/api/auth/google/callback
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# Optional — TypeSafe "Jev" event classification. With this set, each
# calendar event is classified semantically (busy / preferred / flexible /
# ignore) instead of by the built-in regex rules. Without it the app still
# works; it just uses the rules.
# TYPESAFE_API_KEY=""
